<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>

<header class="header-area">
    <!-- Header Top Start -->
    <div class="header-top bg-gray">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <div class="header-top-left">
                        <ul>
                            <li><i class="fa fa-envelope"></i><span>support@flowerstore.com</span></li>
                            <li><i class="fa fa-phone"></i><span>+84 123 456 789</span></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="header-top-right">
                        <ul>
                            <c:choose>
                                <c:when test="${sessionScope.account != null}">
                                    <li><a href="${pageContext.request.contextPath}/profile">Xin chào, ${sessionScope.account.fullName}</a></li>
                                    <li><a href="${pageContext.request.contextPath}/logout">Đăng xuất</a></li>
                                </c:when>
                                <c:otherwise>
                                    <li><a href="${pageContext.request.contextPath}/login">Đăng nhập</a></li>
                                    <li><a href="${pageContext.request.contextPath}/register">Đăng ký</a></li>
                                </c:otherwise>
                            </c:choose>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Header Top End -->
    <!-- Header Bottom Start -->
    <div class="header-bottom-area header-sticky">
        <div class="container">
            <div class="row">
                <div class="col-lg-2 col-md-5 col-5">
                    <div class="logo">
                        <a href="${pageContext.request.contextPath}/"><img src="${pageContext.request.contextPath}/img/logo/logo.png" alt="logo-image"></a>
                    </div>
                </div>
                <div class="col-lg-8 d-none d-lg-block">
                    <div class="main-menu-area text-center">
                        <nav class="main-menu">
                            <ul>
                                <li><a href="${pageContext.request.contextPath}/">Trang chủ</a></li>
                                <li><a href="${pageContext.request.contextPath}/home">Sản phẩm</a></li>
                                <li><a href="${pageContext.request.contextPath}/combo">Combo</a></li>
                                <li><a href="${pageContext.request.contextPath}/blog">Blog</a></li>
                                <li><a href="${pageContext.request.contextPath}/contact">Liên hệ</a></li>
                                <c:if test="${sessionScope.account != null}">
                                    <li><a href="#">Tài khoản<i class="fa fa-angle-down"></i></a>
                                        <ul class="dropdown">
                                            <li><a href="${pageContext.request.contextPath}/profile">Thông tin tài khoản</a></li>
                                            <li><a href="${pageContext.request.contextPath}/my-orders">Đơn hàng của tôi</a></li>
                                            <li><a href="${pageContext.request.contextPath}/my-feedbacks">Đánh giá của tôi</a></li>
                                            <li><a href="${pageContext.request.contextPath}/change-password">Đổi mật khẩu</a></li>
                                        </ul>
                                    </li>
                                </c:if>
                            </ul>
                        </nav>
                    </div>
                </div>
                <div class="col-lg-2 col-md-7 col-7">
                    <div class="header-bottom-right-wrap text-end">
                        <ul>
                            <li>
                                <a href="javascript:void(0);" class="search-btn">
                                    <i class="fa fa-search"></i>
                                </a>
                                <div class="search-form">
                                    <form action="${pageContext.request.contextPath}/home" method="get">
                                        <input type="text" name="search" placeholder="Tìm kiếm sản phẩm...">
                                        <button type="submit"><i class="fa fa-search"></i></button>
                                    </form>
                                </div>
                            </li>
                            <li>
                                <a href="${pageContext.request.contextPath}/cart">
                                    <i class="fa fa-shopping-cart"></i>
                                    <c:if test="${not empty sessionScope.cart && sessionScope.cart.size() > 0}">
                                        <span class="cart-notification">${sessionScope.cart.size()}</span>
                                    </c:if>
                                </a>
                            </li>
                            <li><a href="javascript:void(0);" class="menu-bar"><i class="fa fa-bars"></i></a></li>
                        </ul>
                    </div>
                </div>
                <div class="mobile-menu-area d-lg-none">
                    <div class="mobile-menu mean-container">
                        <div class="mean-bar">
                            <nav class="mean-nav">
                                <ul style="display: none;">
                                    <li><a href="${pageContext.request.contextPath}/">Trang chủ</a></li>
                                    <li><a href="${pageContext.request.contextPath}/home">Sản phẩm</a></li>
                                    <li><a href="${pageContext.request.contextPath}/combo">Combo</a></li>
                                    <li><a href="${pageContext.request.contextPath}/blog">Blog</a></li>
                                    <li><a href="${pageContext.request.contextPath}/contact">Liên hệ</a></li>
                                    <c:if test="${sessionScope.account != null}">
                                        <li>
                                            <a href="#">Tài khoản</a>
                                            <ul class="dropdown">
                                                <li><a href="${pageContext.request.contextPath}/profile">Thông tin tài khoản</a></li>
                                                <li><a href="${pageContext.request.contextPath}/my-orders">Đơn hàng của tôi</a></li>
                                                <li><a href="${pageContext.request.contextPath}/my-feedbacks">Đánh giá của tôi</a></li>
                                                <li><a href="${pageContext.request.contextPath}/change-password">Đổi mật khẩu</a></li>
                                            </ul>
                                            <a class="mean-expand" href="#">+</a>
                                        </li>
                                    </c:if>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Header Bottom End -->
</header>